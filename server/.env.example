# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB via Docker Compose (matches docker-compose.yml service):
MONGODB_URI=mongodb://admin:adminpassword123@mongodb:27017/taskmanager?authSource=admin

# Local MongoDB without Docker:
# MONGODB_URI=mongodb://localhost:27017/taskmanager

# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/taskmanager?retryWrites=true&w=majority

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- CORS ---
# Single origin or comma-separated list, e.g.:
# CLIENT_ORIGIN=https://taskflow.vercel.app,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# --- Seeding ---
# Set to true to wipe and re-seed on next restart. Leave false/unset in production.
FORCE_RESEED=false
